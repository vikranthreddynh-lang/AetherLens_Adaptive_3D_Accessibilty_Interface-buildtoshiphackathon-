NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_LIVE_MODEL=gemini-2.5-flash
GEMINI_SUMMARY_MODEL=gemini-2.5-flash

MAX_AUDIO_CHUNK_BYTES=65536
MAX_VIDEO_FRAME_BYTES=1048576
MAX_WEBSOCKET_MESSAGE_BYTES=2097152

MAX_LIVE_SESSIONS_PER_USER=1
MAX_GUEST_SESSIONS_PER_IP=5

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
AI_RATE_LIMIT_MAX_REQUESTS=20

LIVE_SESSION_MAX_DURATION_MS=300000
WEBSOCKET_IDLE_TIMEOUT_MS=60000
WS_RECONNECT_LIMIT=3

LOG_LEVEL=info
