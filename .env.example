# Copy the server variables to apps/api/.env.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_LIVE_MODEL=gemini-3.8-flash
GEMINI_SUMMARY_MODEL=gemini-3.8-flash

# Copy only the browser-safe values to apps/web/.env.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_WS_BASE_URL=ws://localhost:4000/api/v1/live
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
